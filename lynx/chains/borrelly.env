# Chain profile for Borrelly. Sourced by lynx/build.sh.

# Must equal NAME of the coin class in src/electrumx/lib/lynx_chains.py.
COIN_NAME="Borrelly"

# Where the Spark installer puts the node (bash <(curl -sL install.getlynx.io)).
NODE_SERVICE="borrelly"
NODE_CONF="/var/lib/borrelly/borrelly.conf"
NODE_COOKIE="/var/lib/borrelly/.cookie"

# Public Electrum ports. Only TLS is offered: no plaintext TCP.
SSL_PORT=50002
WSS_PORT=50004

# Warn (not fail) below these. Estimates; revisit after the first full sync.
MIN_DISK_GB=30
MIN_RAM_GB=2

# ElectrumX UTXO/history cache, in MB. Lower on small VPSes.
CACHE_MB=1200
