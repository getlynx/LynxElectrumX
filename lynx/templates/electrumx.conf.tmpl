# ElectrumX configuration for ${COIN_NAME}.
# Written by lynx/build.sh (LynxElectrumX ${VERSION}). Re-running build.sh
# overwrites this file. Full reference: docs/environment.rst.
#
# Contains the node's RPC credentials: keep it root:electrumx, mode 640.

# Coin class to use; must match a NAME in src/electrumx/lib/lynx_chains.py.
COIN=${COIN_NAME}

# Node JSON-RPC endpoint, read from ${NODE_CONF}.
DAEMON_URL=${DAEMON_URL}

# Database location and engine. DB_ENGINE is mandatory in ElectrumX 2.0.
DB_DIRECTORY=${DB_DIRECTORY}
DB_ENGINE=${DB_ENGINE}

# Memory for the UTXO/history cache, in MB.
CACHE_MB=${CACHE_MB}

# Listening services. Only TLS is public; rpc:// is the local admin
# interface used by electrumx_rpc (127.0.0.1:8000).
SERVICES=ssl://:${SSL_PORT},wss://:${WSS_PORT},rpc://

# What this server tells clients and peers to connect to.
REPORT_SERVICES=ssl://${DOMAIN}:${SSL_PORT},wss://${DOMAIN}:${WSS_PORT}

# TLS certificate and key, copied here by the certbot deploy hook
# (or generated by build.sh in self-signed mode).
SSL_CERTFILE=${TLS_DIR}/fullchain.pem
SSL_KEYFILE=${TLS_DIR}/privkey.pem

# Per-session resource limits. These are ElectrumX's defaults.
COST_SOFT_LIMIT=1000
COST_HARD_LIMIT=10000
